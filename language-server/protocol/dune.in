(library
 (name protocol)
 (public_name vsrocq-language-server.lsp)
 (instrumentation (backend bisect_ppx))
 (libraries sexplib yojson @@ROCQ_RUNTIME@@.sysinit lsp)
 (preprocess
   (staged_pps ppx_import ppx_sexp_conv ppx_yojson_conv ppx_optcomp -- -cookie "ppx_optcomp.env=env ~rocq:(Defined \"@@ROCQVERSION@@\")")))
