(executable
 (name vsrocqtop)
 (public_name vsrocqtop)
 (flags -linkall)
 (package vsrocq-language-server)
 (instrumentation (backend bisect_ppx))
 (preprocess (pps ppx_optcomp -- -cookie "ppx_optcomp.env=env ~rocq:(Defined \"@@ROCQVERSION@@\")"))
 (libraries @@ROCQ_RUNTIME@@.sysinit @@ROCQ_RUNTIME@@.tactics sel yojson dm lsp))
